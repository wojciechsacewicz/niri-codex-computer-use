pkgname=niri-codex-computer-use
pkgver=0.1.1
pkgrel=1
pkgdesc='Background Codex computer use on niri with a visible agent cursor'
arch=('x86_64')
url='https://github.com/wojciechsacewicz/niri-codex-computer-use'
license=('MIT' 'GPL-3.0-or-later')
depends=('niri' 'cairo' 'glib2' 'libinput' 'libpipewire' 'libxkbcommon' 'mesa' 'pango' 'pixman' 'seatd' 'systemd-libs' 'bash' 'python')
options=('!strip' '!debug' '!lto')
# Developer packaging of previously tested build outputs.
package() {
    : "${NCCU_PROJECT_ROOT:?Set NCCU_PROJECT_ROOT to the reviewed project checkout}"
    source "$NCCU_PROJECT_ROOT/packaging/arch/package-files.sh"
    nccu_package_files "$NCCU_PROJECT_ROOT" "$pkgdir"
}

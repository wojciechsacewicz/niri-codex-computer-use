pkgname=niri-codex-computer-use
pkgver=0.1.0
pkgrel=1
pkgdesc='Background Codex computer use on niri with a visible agent cursor'
arch=('x86_64')
license=('MIT' 'GPL-3.0-or-later')
depends=('niri' 'cairo' 'glib2' 'libinput' 'libpipewire' 'libxkbcommon' 'mesa' 'pango' 'pixman' 'seatd' 'systemd-libs' 'bash')
options=('!strip' '!debug')
# This local package uses verified build outputs. Release packaging must use
# immutable source pins and pass the same native checks before publication.
package() {
    : "${NCCU_PROJECT_ROOT:?Set NCCU_PROJECT_ROOT to the reviewed project checkout}"
    local root="$NCCU_PROJECT_ROOT"
    install -Dm755 "$root/.local/outputs/niri" "$pkgdir/usr/lib/$pkgname/bin/niri"
    install -Dm755 "$root/.local/outputs/codex-computer-use-linux" "$pkgdir/usr/lib/$pkgname/bin/codex-computer-use-linux"
    install -Dm755 "$root/packaging/arch/niri-codex-session" "$pkgdir/usr/bin/niri-codex-session"
    install -Dm755 "$root/packaging/arch/niri-codex-computer-use" "$pkgdir/usr/bin/niri-codex-computer-use"
    install -Dm644 "$root/packaging/arch/niri-codex.desktop" "$pkgdir/usr/share/wayland-sessions/niri-codex.desktop"
    install -Dm644 "$root/packaging/arch/niri-codex.service" "$pkgdir/usr/lib/systemd/user/niri-codex.service"
    install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$root/LICENSES/GPL-3.0-or-later.txt" "$pkgdir/usr/share/licenses/$pkgname/GPL-3.0-or-later.txt"
    install -Dm644 "$root/sources.lock.json" "$pkgdir/usr/share/$pkgname/sources.lock.json"
    install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}

 impl AgentInputState {
+    fn context_tint(&mut self, window_id: u64, agent_id: Option<&str>) -> Result<[f32; 3], String> {
+        let tints = &mut self.context_tints;
+        if let Some((_, tint)) = tints
+            .entries
+            .iter()
+            .find(|(id, _)| id.as_deref() == agent_id)
+        {
+            return Ok(*tint);
+        }
+        if tints.entries.len() == MAX_AGENT_CONTEXTS {
+            let inactive = tints
+                .entries
+                .iter()
+                .position(|(id, _)| {
+                    !self.cursors.iter().any(|(window, cursor)| {
+                        *window != window_id && cursor.agent_id.as_deref() == id.as_deref()
+                    })
+                })
+                .ok_or_else(|| {
+                    format!("maximum of {MAX_AGENT_CONTEXTS} active agent contexts reached")
+                })?;
+            tints.entries.remove(inactive);
+        }
+        let hue = (tints.hash_keys.hash_one(agent_id) & 0xffffff) as f32 / 16777216. * 6.;
+        let tint = cursor_tint_for_hue(hue);
+        tints.entries.push_back((agent_id.map(str::to_owned), tint));
+        Ok(tint)
+    }
+
+    fn move_cursor(
+        &mut self,
+        window_id: u64,
+        pos: Point<f64, Logical>,
+        now: Instant,
+        agent_id: Option<&str>,
+        tint: [f32; 3],
+    ) {
+        self.cursors
+            .entry(window_id)
+            .and_modify(|cursor| {
+                cursor.set_context(agent_id, tint);
+                cursor.move_to(pos, now);
+            })
+            .or_insert_with(|| AgentCursor::new(pos, now, agent_id, tint));
+    }

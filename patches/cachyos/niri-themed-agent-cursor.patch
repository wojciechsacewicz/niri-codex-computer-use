+#[cfg(test)]
+mod themed_cursor_tests {
+    use super::*;
+
+    #[test]
+    fn snapshot_reuses_theme_frames_scale_hotspot_and_animation() {
+        let frames = vec![
+            Image {
+                size: 24, width: 4, height: 6, xhot: 2, yhot: 4, delay: 10,
+                pixels_rgba: vec![11; 4 * 6 * 4], pixels_argb: vec![],
+            },
+            Image {
+                size: 24, width: 6, height: 8, xhot: 4, yhot: 6, delay: 20,
+                pixels_rgba: vec![22; 6 * 8 * 4], pixels_argb: vec![],
+            },
+        ];
+        let source = Rc::new(XCursor { images: frames, animation_duration: 30 });
+        let mut manager = CursorManager {
+            theme: CursorTheme::load("default"), size: 24,
+            current_cursor: CursorImageStatus::Named(CursorIcon::Default),
+            named_cursor_cache: Default::default(),
+        };
+        manager.named_cursor_cache.get_mut().insert((CursorIcon::Default, 2), Some(source.clone()));
+        let textures = CursorTextureCache::default();
+        let first = manager.agent_cursor_image(2, 0, &textures);
+        let next = manager.agent_cursor_image(2, 10, &textures);
+        assert!(first.is_animated());
+        assert_eq!(first, manager.agent_cursor_image(2, 30, &textures));
+        assert_ne!(first, next);
+        match next {
+            AgentCursorImage::Named { cursor, idx, scale, hotspot, .. } => {
+                assert!(Rc::ptr_eq(&cursor, &source));
+                assert_eq!(idx, 1);
+                assert_eq!(scale, 2);
+                assert_eq!(hotspot, (2, 3).into());
+                assert_eq!((cursor.frames()[idx].width, cursor.frames()[idx].height), (6, 8));
+            }
+            _ => panic!("expected the original named theme cursor"),
+        }
+        assert_eq!(source.frames()[0].pixels_rgba, vec![11; 4 * 6 * 4]);
+        assert_eq!(source.frames()[1].pixels_rgba, vec![22; 6 * 8 * 4]);
+        assert!(matches!(manager.cursor_image(), CursorImageStatus::Named(CursorIcon::Default)));
+        manager.set_cursor_image(CursorImageStatus::Hidden);
+        assert_eq!(manager.agent_cursor_image(2, 10, &textures), AgentCursorImage::Hidden);
+    }
+}

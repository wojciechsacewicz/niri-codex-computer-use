+#[cfg(test)]
+mod themed_cursor_tests {
+    use super::*;
+
+    #[test]
+    fn context_tint_survives_windows_leave_expiry_and_fifo_eviction() {
+        let mut state = AgentInputState::default();
+        let now = Instant::now();
+        let tint = state.context_tint(1, Some("agent-a")).unwrap();
+        state.move_cursor(1, (10., 20.).into(), now, Some("agent-a"), tint);
+        state.move_cursor(2, (30., 40.).into(), now, Some("agent-a"), tint);
+        assert_eq!(state.cursors[&1].tint, state.cursors[&2].tint);
+        state.cursors.remove(&1); // PointerLeave.
+        assert_eq!(state.context_tint(1, Some("agent-a")).unwrap(), tint);
+        // The same retention as refresh_mapped_agent_state after indicators expire.
+        state.cursors.retain(|id, _| state.windows.contains_key(id));
+        assert!(state.cursors.is_empty());
+        assert_eq!(state.context_tint(3, Some("agent-a")).unwrap(), tint);
+        for i in 0..MAX_AGENT_CONTEXTS {
+            state
+                .context_tint(4, Some(&format!("inactive-{i}")))
+                .unwrap();
+        }
+        assert!(!state
+            .context_tints
+            .entries
+            .iter()
+            .any(|(id, _)| id.as_deref() == Some("agent-a")));
+        let revived = state.context_tint(3, Some("agent-a")).unwrap();
+        state.move_cursor(3, (50., 60.).into(), now, Some("agent-a"), revived);
+        assert_eq!(state.cursors[&3].tint, tint);
+        assert_eq!(state.context_tints.entries.len(), MAX_AGENT_CONTEXTS);
+        let legacy = state.context_tint(5, None).unwrap();
+        assert_eq!(state.context_tint(6, None).unwrap(), legacy);
+    }
+
+    #[test]
+    fn latest_context_changes_window_tint_and_render_identity() {
+        let mut state = AgentInputState::default();
+        let now = Instant::now();
+        let first = state.context_tint(1, Some("agent-a")).unwrap();
+        state.move_cursor(1, (10., 20.).into(), now, Some("agent-a"), first);
+        let source = Id::new();
+        let id = state.cursors[&1].render_id(&source);
+        let second = state.context_tint(1, Some("agent-b")).unwrap();
+        state.move_cursor(1, (30., 40.).into(), now, Some("agent-b"), second);
+        assert_eq!(state.cursors[&1].agent_id.as_deref(), Some("agent-b"));
+        assert_eq!(state.cursors[&1].tint, second);
+        assert_ne!(state.cursors[&1].render_id(&source), id);
+        assert_eq!(state.context_tints.entries.len(), 2);
+        assert_eq!(state.context_tint(2, Some("agent-a")).unwrap(), first);
+        assert_eq!(state.context_tint(2, Some("agent-b")).unwrap(), second);
+    }
+
+    #[test]
+    fn cache_preserves_active_contexts_and_refuses_overflow() {
+        let mut state = AgentInputState::default();
+        let now = Instant::now();
+        for window in 0..MAX_AGENT_CONTEXTS as u64 {
+            let context = format!("active-{window}");
+            let tint = state.context_tint(window, Some(&context)).unwrap();
+            state.move_cursor(window, (0., 0.).into(), now, Some(&context), tint);
+        }
+        let entries = state.context_tints.entries.clone();
+        assert!(state.context_tint(999, Some("overflow")).is_err());
+        assert_eq!(state.context_tints.entries, entries);
+        // Replacing one window frees its old context only if no other window uses it.
+        state.cursors.insert(1000, state.cursors[&0].clone());
+        assert!(state.context_tint(0, Some("replacement")).is_err());
+        assert_eq!(state.context_tints.entries, entries);
+        state.cursors.remove(&1000);
+        let tint = state.context_tint(0, Some("replacement")).unwrap();
+        state.move_cursor(0, (0., 0.).into(), now, Some("replacement"), tint);
+        assert_eq!(state.context_tints.entries.len(), MAX_AGENT_CONTEXTS);
+        assert!(!state
+            .context_tints
+            .entries
+            .iter()
+            .any(|(id, _)| id.as_deref() == Some("active-0")));
+        for window in 1..MAX_AGENT_CONTEXTS {
+            let context = format!("active-{window}");
+            assert_eq!(

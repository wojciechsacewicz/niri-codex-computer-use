+
+/// The same image and frame as the physical pointer, with an independent render identity.
+#[derive(Debug, Clone)]
+pub enum AgentCursorImage {
+    Hidden,
+    Surface {
+        hotspot: Point<i32, Logical>,
+        surface: WlSurface,
+    },
+    Named {
+        cursor: Rc<XCursor>,
+        idx: usize,
+        scale: i32,
+        hotspot: Point<i32, Logical>,
+        buffer: MemoryRenderBuffer,
+    },
+}
+
+impl AgentCursorImage {
+    pub fn is_animated(&self) -> bool {
+        matches!(self, Self::Named { cursor, .. } if cursor.is_animated_cursor())
+    }
+}
+
+impl PartialEq for AgentCursorImage {
+    fn eq(&self, other: &Self) -> bool {
+        match (self, other) {
+            (Self::Hidden, Self::Hidden) => true,
+            (
+                Self::Surface {
+                    hotspot: a,
+                    surface: sa,
+                },
+                Self::Surface {
+                    hotspot: b,
+                    surface: sb,
+                },
+            ) => a == b && sa == sb,
+            (
+                Self::Named {
+                    cursor: a,
+                    idx: ia,
+                    scale: sa,
+                    ..
+                },
+                Self::Named {
+                    cursor: b,
+                    idx: ib,
+                    scale: sb,
+                    ..
+                },
+            ) => Rc::ptr_eq(a, b) && ia == ib && sa == sb,
+            _ => false,
+        }
+    }
+}

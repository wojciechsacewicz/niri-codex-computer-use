+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+let sequence = 0;
+
+// This checks the candidate SDK contract with a fake host, not privileged pipe access.
+export async function validateRuntime({ installDir = process.env.INSTALL_DIR, createService } = {}) {
+  assert(installDir && path.isAbsolute(installDir), 'INSTALL_DIR must be an absolute candidate directory');
+  const scripts = path.join(installDir, 'resources/plugins/openai-bundled/plugins/unified-computer-use/scripts');
+  createService ??= (await import(pathToFileURL(path.join(scripts, 'native-service.mjs')))).createNativeService;
+  const require = createRequire(path.join(installDir, 'resources/cua_node/lib/package.json'));
+  const skyPath = path.join(path.dirname(require.resolve('@oai/sky')), 'sky.js');
+  const statePath = path.join(path.dirname(require.resolve('@oai/cua')), 'get_state.js');
+  const inventory = [
+    { id: 'linux-window:22', displayName: 'Validator', title: 'Synthetic window', isRunning: true },
+    { id: 'linux-window:18446744073709551615', displayName: 'Validator large ID', title: 'Synthetic large window', isRunning: true },
+  ];
+  const windows = [
+    { id: 22, app: 'Validator', title: 'Synthetic window' },
+    { id: '18446744073709551615', app: 'Validator large ID', title: 'Synthetic large window' },
+  ];
+  const connection = new EventEmitter();
+  const expectedError = 'synthetic Linux CUA host failure';
+  let failHost = false, connections = 0, requests = 0;
+  connection.end = () => {};
+  connection.write = bytes => {
+    const { id, input } = JSON.parse(Buffer.from(bytes).toString('utf8'));
+    assert.deepEqual(input, { method: 'list_apps' }, 'SDK smoke must only request synthetic inventory');
+    requests += 1;
+    const response = Buffer.from(JSON.stringify(failHost ? { id, error: expectedError } : { id, result: inventory }) + '\n');
+    queueMicrotask(() => {
+      connection.emit('data', response.subarray(0, 5));
+      connection.emit('data', response.subarray(5));
+    });
+  };
+  const service = createService({ connect: async () => { connections += 1; return connection; }, timeoutMs: 1000 });
+  const previous = globalThis.nodeRepl;
+  try {
+    assert.deepEqual(await service.handleRpc({ type: 'setup' }), { target: 'linux', methods: ['list_apps', 'list_windows'] });
+    assert.equal(connections, 0, 'setup must not connect to the host');
+    globalThis.nodeRepl = { rpc(name, input) { assert.equal(name, 'sky'); return service.handleRpc(input); } };
+    const skyUrl = pathToFileURL(skyPath);
+    skyUrl.searchParams.set('linuxUpdateValidation', String(++sequence));
+    const { sky } = await import(skyUrl);
+    const { get_state } = await import(pathToFileURL(statePath));
+    assert.equal(sky.target, 'linux');
+    for (const method of ['list_apps', 'list_windows']) assert.equal(typeof sky[method], 'function', `SDK did not bootstrap ${method}`);
+    const expectedApps = inventory.map((app, index) => ({ id: app.id, displayName: app.displayName, isRunning: true, windows: [windows[index]] }));
+    assert.deepEqual(await get_state({ computer: sky }), { apps: expectedApps, browsers: [] });
+    assert.deepEqual(await sky.list_windows(), windows);
+    failHost = true;
+    await assert.rejects(sky.list_apps(), error => error.message === expectedError);
+    const failedState = await get_state({ computer: sky });
+    assert.deepEqual(failedState.apps, []);
+    assert.equal(failedState.errors?.length, 1, 'get_state must preserve inventory errors');
+    assert(failedState.errors[0].includes(expectedError), 'get_state lost the host error');
+    assert.equal(requests, 4, 'SDK inventory must reach the fake transport without replay');
+    assert.equal(connections, 1);
+  } finally {
+    service.shutdown();
+    if (previous === undefined) delete globalThis.nodeRepl;
+    else globalThis.nodeRepl = previous;
+  }
+}
+
+if (process.argv[1] && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url) {
+  const deadline = setTimeout(() => {
+    console.error('Linux Computer Use candidate SDK validation timed out');
+    process.exit(1);
+  }, 5000);
+  try {
+    await validateRuntime();
+    console.log('Linux Computer Use candidate SDK inventory validation passed (fake host)');
+  } catch (error) {
+    console.error(`Linux Computer Use candidate SDK validation failed: ${error.message}`);
+    process.exitCode = 1;
+  } finally { clearTimeout(deadline); }
+}

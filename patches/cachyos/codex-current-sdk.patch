+'use strict';
+const assert = require('node:assert/strict');
+const { execFileSync, spawnSync } = require('node:child_process');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { pathToFileURL } = require('node:url');
+const test = require('node:test');
+
+const repoRoot = path.resolve(__dirname, '../..');
+const installDir = process.env.INSTALL_DIR;
+const candidateTest = { skip: !installDir };
+
+async function modules() {
+  const { validateRuntime } = await import('./validate-runtime.mjs');
+  const { createNativeService } = await import(pathToFileURL(path.join(installDir,
+    'resources/plugins/openai-bundled/plugins/unified-computer-use/scripts/native-service.mjs')));
+  return { validateRuntime, createNativeService };
+}
+
+test('candidate SDK bootstraps inventory and preserves synthetic host errors', candidateTest, async () => {
+  const { validateRuntime } = await modules();
+  await validateRuntime({ installDir });
+});
+
+test('validator rejects an incomplete setup handshake', candidateTest, async () => {
+  const { validateRuntime, createNativeService } = await modules();
+  await assert.rejects(validateRuntime({ installDir, createService(options) {
+    const service = createNativeService(options);
+    return { ...service, handleRpc: input => input.type === 'setup'
+      ? Promise.resolve({ target: 'linux', methods: ['list_apps'] }) : service.handleRpc(input) };
+  } }), /list_windows/);
+});
+
+test('validator rejects a service that cannot execute the SDK wire protocol', candidateTest, async () => {
+  const { validateRuntime, createNativeService } = await modules();
+  await assert.rejects(validateRuntime({ installDir, createService(options) {
+    const service = createNativeService(options);
+    return { ...service, handleRpc: input => input.type === 'execute'
+      ? Promise.reject(new Error('deliberately broken execute protocol')) : service.handleRpc(input) };
+  } }), /deliberately broken execute protocol/);
+});
+
+test('validator rejects swallowed host errors', candidateTest, async () => {
+  const { validateRuntime, createNativeService } = await modules();
+  await assert.rejects(validateRuntime({ installDir, createService(options) {
+    const service = createNativeService(options);
+    return { ...service, handleRpc: input => service.handleRpc(input).catch(() => []) };
+  } }), /Missing expected rejection/);
+});
+
+test('stage rejects a missing candidate Node before changing the plugin', t => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'cua-stage-validation-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const result = spawnSync('bash', [path.join(__dirname, 'stage.sh')], {
+    encoding: 'utf8', env: { ...process.env, SCRIPT_DIR: repoRoot, INSTALL_DIR: root,
+      CODEX_COMPUTER_USE_BINARY_SOURCE: process.execPath, CODEX_COMPUTER_USE_COSMIC_BINARY_SOURCE: process.execPath },
+  });
+  assert.notEqual(result.status, 0);
+  assert.match(result.stderr, /candidate bundled Node runtime is missing/);
+  assert.equal(fs.existsSync(path.join(root, 'resources/plugins')), false);
+});
+
+test('validator sources survive two successive update-builder feature snapshots', candidateTest, t => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'cua-validator-snapshots-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  const config = path.join(root, 'features.json');
+  fs.writeFileSync(config, JSON.stringify({ enabled: ['computer-use-linux'] }));
+  const files = ['stage.sh', 'validate-runtime.mjs', 'validator.test.js', 'native.test.js', 'unified.test.js', 'host-service.test.js'];
+  let source = repoRoot;
+  for (let generation = 1; generation <= 2; generation += 1) {
+    const snapshot = path.join(root, `builder-${generation}`);
+    execFileSync('bash', ['-c', 'REPO_DIR=$1\nAPP_DIR=$3\n. "$REPO_DIR/scripts/lib/package-common.sh"\nstage_update_builder_linux_features_tree "$2"',
+      'snapshot', source, snapshot, installDir], {
+      encoding: 'utf8', timeout: 5000,
+      env: { ...process.env, CODEX_LINUX_FEATURES_CONFIG: config, CODEX_LINUX_FEATURES_ROOT: path.join(source, 'linux-features') },
+    });
+    for (const name of files) {
+      assert.deepEqual(fs.readFileSync(path.join(snapshot, 'linux-features/computer-use-linux', name)), fs.readFileSync(path.join(__dirname, name)));

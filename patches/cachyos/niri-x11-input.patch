 impl State {
+    fn agent_is_satellite_client(&self, client: &Client) -> Result<bool, String> {
+        let unidentified = || String::from("cannot identify text target; no input was sent");
+        let credentials = client.get_credentials(&self.niri.display_handle)
+            .map_err(|_| unidentified())?;
+        let executable = std::fs::read_link(format!("/proc/{}/exe", credentials.pid))
+            .map_err(|_| unidentified())?;
+        let config = self.niri.config.borrow();
+        let path = std::path::Path::new(&config.xwayland_satellite.path);
+        let expanded = crate::utils::expand_home(path).map_err(|_| unidentified())?;
+        let path = expanded.as_deref().unwrap_or(path);
+        let configured = if path.components().count() > 1 || path.is_absolute() {
+            path.canonicalize().ok()
+        } else {
+            std::env::var_os("PATH").and_then(|paths| {
+                std::env::split_paths(&paths).find_map(|dir| dir.join(path).canonicalize().ok())
+            })
+        }.ok_or_else(unidentified)?;
+        Ok(configured == executable)
+    }

     use super::*;
 
     #[test]
+    fn agent_motion_reenters_after_cursor_expiry_and_context_reuse() {
+        let mut state = AgentInputState::default();
+        let now = Instant::now();
+        let tint = state.context_tint(1, Some("agent-a")).unwrap();
+        state.move_cursor(1, (10., 20.).into(), now, Some("agent-a"), tint);
+        assert_eq!(state.motion_delta(1, (15., 25.).into(), false),
+                   (false, (5., 5.).into()));
+        // Refresh can expire an indicator while its protocol surface stays entered.
+        state.cursors.retain(|id, _| state.windows.contains_key(id));
+        assert_eq!(state.motion_delta(1, (100., 200.).into(), false),
+                   (true, (0., 0.).into()));
+        let tint = state.context_tint(1, Some("agent-b")).unwrap();
+        assert_eq!(state.motion_delta(1, (100., 200.).into(), false),
+                   (true, (0., 0.).into()));
+        state.move_cursor(1, (100., 200.).into(), now, Some("agent-b"), tint);
+        assert_eq!(state.motion_delta(1, (103., 204.).into(), false),
+                   (false, (3., 4.).into()));
+        assert_eq!(state.motion_delta(1, (103., 204.).into(), true),
+                   (true, (0., 0.).into()));
+    }

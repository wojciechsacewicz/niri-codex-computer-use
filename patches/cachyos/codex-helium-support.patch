+{
+  "id": "helium-browser-support",
+  "title": "Helium Browser Support",
+  "description": "Recognize Helium profiles and prefer Helium for Linux Chromium browser actions.",
+  "defaultEnabled": false,
+  "entrypoints": { "patchDescriptors": "./patch.js" }
+}
diff --git a/linux-features/helium-browser-support/patch.js b/linux-features/helium-browser-support/patch.js
new file mode 100644
index 0000000..ca792b1
--- /dev/null
+++ b/linux-features/helium-browser-support/patch.js
@@ -0,0 +1,64 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+
+// The settings checker and URL launcher consume this shared registry. Patch
+// its Linux Chrome-family entry, preserving upstream extension IDs and the
+// Windows/macOS entries. Helium uses the Chrome extension protocol.
+const LINUX_ENTRY = /linux:\{installations:\[(.*?)\],nativeMessagingManifestDirectories:\[(.*?)\],processNames:\[(.*?)\],userDataDirectorySegments:\[(.*?)\]\}/g;
+const PROFILE = "net.imput.helium";
+
+function patchSource(source) {
+  const matches = [...source.matchAll(LINUX_ENTRY)].filter((match) =>
+    match[4].replaceAll('"', '`') === '`.config`,`google-chrome`',
+  );
+  if (matches.length !== 1) {
+    throw new Error(`Expected one Linux Chrome registry entry; found ${matches.length}`);
+  }
+  const match = matches[0];
+  const quote = match[1].includes('`google-chrome`') ? '`' : '"';
+  const q = (value) => `${quote}${value}${quote}`;
+  const installation = `{commands:[${q("helium-browser")},${q("helium")}],userDataDirName:${q(PROFILE)}}`;
+  const manifest = q(`.config/${PROFILE}/NativeMessagingHosts`);
+  const processes = `${q("helium")},${q("helium-browser")}`;
+  const alreadyPatched = match[1].startsWith(`${installation},`) &&
+    match[2].startsWith(`${manifest},`) && match[3].endsWith(`,${processes}`);
+  if (alreadyPatched) return { source, changed: false };
+  if (match[0].includes(PROFILE) || match[0].includes(q("helium"))) {
+    throw new Error("Incomplete Helium browser registry patch");
+  }
+  if (!match[1].startsWith(`{commands:[${q("google-chrome")},${q("google-chrome-stable")}]`) ||
+      !match[2].includes(q(".config/google-chrome/NativeMessagingHosts")) ||
+      match[3] !== q("chrome")) {
+    throw new Error("Linux Chrome registry contract changed");
+  }
+  const replacement = `linux:{installations:[${installation},${match[1]}],nativeMessagingManifestDirectories:[${manifest},${match[2]}],processNames:[${match[3]},${processes}],userDataDirectorySegments:[${match[4]}]}`;
+  return { source: source.slice(0, match.index) + replacement + source.slice(match.index + match[0].length), changed: true };
+}
+
+function patchApp(extractedDir) {
+  const buildDir = path.join(extractedDir, ".vite", "build");
+  const candidates = fs.readdirSync(buildDir).filter((name) => name.endsWith(".js"))
+    .map((name) => ({ file: path.join(buildDir, name), source: fs.readFileSync(path.join(buildDir, name), "utf8") }))
+    .filter(({ source }) => source.includes("userDataDirName:") && source.includes("google-chrome-for-testing"));
+  if (candidates.length !== 2) throw new Error(`Expected two shared browser registries; found ${candidates.length}`);
+  // Validate every target before writing any of them.
+  const results = candidates.map((candidate) => ({ ...candidate, result: patchSource(candidate.source) }));
+  for (const { file, result } of results) if (result.changed) fs.writeFileSync(file, result.source);
+  return { matched: results.length, changed: results.filter(({ result }) => result.changed).length,
+    targets: results.map(({ file }) => path.relative(extractedDir, file)) };
+}
+
+module.exports = {
+  patchSource,
+  patchApp,
+  descriptors: [{
+    id: "desktop-browser-registry",
+    phase: "extracted-app:pre-webview",
+    order: 20510,
+    ciPolicy: "opt-in",
+    apply: patchApp,
+    status: (result) => result.changed > 0 ? "applied" : "already-applied",
+  }],
+};
diff --git a/linux-features/helium-browser-support/test.js b/linux-features/helium-browser-support/test.js
new file mode 100644
index 0000000..462c778
--- /dev/null
+++ b/linux-features/helium-browser-support/test.js
@@ -0,0 +1,48 @@
+"use strict";
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const vm = require("node:vm");
+const test = require("node:test");
+const { patchSource, patchApp } = require("./patch.js");
+
+const original = '({linux:{installations:[{commands:[`google-chrome`,`google-chrome-stable`],userDataDirName:`google-chrome`},{commands:[`chromium`,`chromium-browser`],userDataDirName:`chromium`},{commands:[`google-chrome-for-testing`],userDataDirName:`google-chrome-for-testing`}],nativeMessagingManifestDirectories:[`.config/google-chrome/NativeMessagingHosts`,`.config/chromium/NativeMessagingHosts`],processNames:[`chrome`],userDataDirectorySegments:[`.config`,`google-chrome`]},macos:{bundleId:`com.google.Chrome`}})';
+
+test("adds real Helium locations without replacing Chrome or other platforms", () => {
+  const before = vm.runInNewContext(original);
+  const after = vm.runInNewContext(patchSource(original).source);
+  assert.equal(after.linux.installations[0].userDataDirName, "net.imput.helium");
+  assert.equal(after.linux.installations[0].commands[0], "helium-browser");
+  assert.equal(JSON.stringify(after.linux.installations.slice(1)), JSON.stringify(before.linux.installations));
+  assert.equal(JSON.stringify(after.macos), JSON.stringify(before.macos));
+  assert.equal(after.linux.nativeMessagingManifestDirectories[0], ".config/net.imput.helium/NativeMessagingHosts");
+  assert.equal(JSON.stringify(after.linux.processNames), '["chrome","helium","helium-browser"]');
+});
+
+test("idempotent for both official string quote styles", () => {
+  for (const source of [original, original.replaceAll('`', '"')]) {
+    const patched = patchSource(source);
+    assert.equal(patched.changed, true);
+    assert.deepEqual(patchSource(patched.source), { source: patched.source, changed: false });
+  }
+});
+
+test("rejects missing, duplicate, changed and partial registry contracts", () => {
+  for (const source of ["", original + original, original.replace('processNames:[`chrome`]', 'processNames:[`other`]'), original.replace('userDataDirName:`chromium`', 'userDataDirName:`net.imput.helium`')]) {
+    assert.throws(() => patchSource(source));
+  }
+});
+
+test("validates both app targets before writing and rejects incomplete inventories", () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "helium-feature-test-"));
+  try {
+    const dir = path.join(root, ".vite", "build"); fs.mkdirSync(dir, { recursive: true });
+    const a = path.join(dir, "shared.js"), b = path.join(dir, "worker.js");
+    fs.writeFileSync(a, original); assert.throws(() => patchApp(root));
+    fs.writeFileSync(b, original.replace('processNames:[`chrome`]', 'processNames:[`other`]'));
+    assert.throws(() => patchApp(root)); assert.equal(fs.readFileSync(a, "utf8"), original);
+    fs.writeFileSync(b, original);
+    assert.equal(patchApp(root).changed, 2); assert.equal(patchApp(root).changed, 0);
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});

diff --git a/computer-use-linux/src/niri_agent.rs b/computer-use-linux/src/niri_agent.rs
new file mode 100644
index 0000000..47b493e
--- /dev/null
+++ b/computer-use-linux/src/niri_agent.rs
@@ -0,0 +1,198 @@
+//! niri agent input: deliver input to one window's client and capture windows without moving
+//! the user's pointer, keyboard focus or active window, and without screenshot notifications
+//! or clipboard changes.
+//!
+//! Requires a niri build with the `AgentInput` / `AgentScreenshot` IPC requests (see the
+//! niri-computer-use repository). Detected at runtime; everything falls back to the regular
+//! backends when niri lacks them, unless `CODEX_COMPUTER_USE_NIRI_AGENT_REQUIRED=1`
+//! requires agent-only operation. Set `CODEX_COMPUTER_USE_NIRI_AGENT=0` to disable.
+
+use anyhow::{anyhow, bail, Context, Result};
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::net::UnixStream;
+use std::sync::Mutex;
+use std::time::Duration;
+
+/// Where the window geometry sits inside the last agent screenshot of a window.
+#[derive(Clone, Copy, Debug)]
+pub struct CaptureGeometry {
+    pub scale: f64,
+    pub geometry_x: i32,
+    pub geometry_y: i32,
+}
+
+static SUPPORT: Mutex<Option<(String, bool)>> = Mutex::new(None);
+static GEOMETRY: Mutex<Option<HashMap<u64, CaptureGeometry>>> = Mutex::new(None);
+
+pub fn background_only() -> bool {
+    std::env::var("CODEX_COMPUTER_USE_NIRI_AGENT_REQUIRED").is_ok_and(|value| value == "1")
+}
+
+pub fn require_foreground_allowed() -> Result<()> {
+    if background_only() {
+        bail!("niri background mode requires a supported targeted agent operation; foreground fallback refused; no input was sent");
+    }
+    Ok(())
+}
+
+fn socket_path() -> Option<String> {
+    std::env::var("NIRI_SOCKET").ok().filter(|s| !s.is_empty())
+}
+
+fn request_blocking(socket: &str, request: &Value) -> Result<Value> {
+    let mut stream = UnixStream::connect(socket)
+        .with_context(|| format!("failed to connect to the niri socket {socket}"))?;
+    stream.set_read_timeout(Some(Duration::from_secs(10)))?;
+    let mut line = serde_json::to_string(request)?;
+    line.push('\n');
+    stream.write_all(line.as_bytes())?;
+    let mut reply = String::new();
+    BufReader::new(stream).read_line(&mut reply)?;
+    let reply: Value = serde_json::from_str(&reply).context("invalid niri IPC reply")?;
+    if let Some(ok) = reply.get("Ok") {
+        return Ok(ok.clone());
+    }
+    let error = reply
+        .get("Err")
+        .and_then(Value::as_str)
+        .unwrap_or("unknown niri IPC error");
+    Err(anyhow!("{error}"))
+}
+
+async fn request(request: Value) -> Result<Value> {
+    let socket = socket_path().ok_or_else(|| anyhow!("NIRI_SOCKET is not set"))?;
+    tokio::task::spawn_blocking(move || request_blocking(&socket, &request))
+        .await
+        .map_err(|e| anyhow!("niri IPC task failed: {e}"))?
+}
+
+/// Whether the running niri accepts agent requests. Cached per niri socket.
+pub fn supported() -> bool {
+    if std::env::var("CODEX_COMPUTER_USE_NIRI_AGENT").is_ok_and(|v| v == "0") {
+        return false;
+    }
+    let Some(socket) = socket_path() else {
+        return false;
+    };
+    let mut cache = SUPPORT.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((cached_socket, supported)) = cache.as_ref() {
+        if *cached_socket == socket {
+            return *supported;
+        }
+    }
+    // A patched niri answers "no window with id 0"; an unpatched one fails to parse the request.
+    let probe = json!({ "AgentInput": { "window_id": 0, "events": [] } });
+    let supported = match request_blocking(&socket, &probe) {
+        Ok(_) => true,
+        Err(error) => error.to_string().contains("no window with id"),
+    };
+    *cache = Some((socket, supported));
+    supported
+}
+
+/// Whether agent input should be used for `window`.
+pub fn applies_to(window: &crate::windowing::WindowInfo) -> bool {
+    window.backend == "niri" && supported()
+}
+
+pub fn capture_geometry(window_id: u64) -> Option<CaptureGeometry> {
+    GEOMETRY.lock().ok()?.as_ref()?.get(&window_id).copied()
+}
+
+/// Screenshot a window into `path`, remembering its capture geometry.
+pub async fn screenshot(window_id: u64, path: &std::path::Path) -> Result<CaptureGeometry> {
+    let path = path
+        .to_str()
+        .ok_or_else(|| anyhow!("screenshot path is not UTF-8"))?
+        .to_string();
+    let reply = request(json!({
+        "AgentScreenshot": { "window_id": window_id, "path": path, "show_pointer": false }
+    }))
+    .await?;
+    let info = reply
+        .get("AgentScreenshot")
+        .ok_or_else(|| anyhow!("unexpected AgentScreenshot reply: {reply}"))?;
+    let geometry = CaptureGeometry {
+        scale: info["scale"].as_f64().unwrap_or(1.0),
+        geometry_x: info["geometry_x"].as_i64().unwrap_or(0) as i32,
+        geometry_y: info["geometry_y"].as_i64().unwrap_or(0) as i32,
+    };
+    if let Ok(mut map) = GEOMETRY.lock() {
+        map.get_or_insert_with(HashMap::new)
+            .insert(window_id, geometry);
+    }
+    Ok(geometry)
+}
+
+/// Capture geometry of a window, taking a throwaway screenshot if none is cached.
+async fn geometry_for(window_id: u64) -> Result<CaptureGeometry> {
+    if let Some(geometry) = capture_geometry(window_id) {
+        return Ok(geometry);
+    }
+    let dir = tempfile_dir()?;
+    let path = dir.join("geometry.png");
+    let result = screenshot(window_id, &path).await;
+    let _ = std::fs::remove_file(&path);
+    let _ = std::fs::remove_dir(&dir);
+    result
+}
+
+pub(crate) fn tempfile_dir() -> Result<std::path::PathBuf> {
+    use std::os::unix::fs::DirBuilderExt;
+    let mut nonce = [0u8; 16];
+    getrandom::fill(&mut nonce).map_err(|e| anyhow!("screenshot nonce: {e}"))?;
+    let name = nonce.iter().map(|b| format!("{b:02x}")).collect::<String>();
+    let directory = std::env::temp_dir().join(format!("codex-niri-{name}"));
+    std::fs::DirBuilder::new().mode(0o700).create(&directory)?;
+    Ok(directory)
+}
+
+/// Convert a point in screenshot capture pixels to window-geometry logical coordinates.
+pub async fn window_point(window_id: u64, x: i32, y: i32) -> Result<(f64, f64)> {
+    let g = geometry_for(window_id).await?;
+    Ok((
+        f64::from(x - g.geometry_x) / g.scale,
+        f64::from(y - g.geometry_y) / g.scale,
+    ))
+}
+
+pub async fn input(window_id: u64, events: Vec<Value>) -> Result<()> {
+    request(json!({ "AgentInput": { "window_id": window_id, "events": events } }))
+        .await
+        .map(|_| ())
+}
+
+pub fn motion(x: f64, y: f64) -> Value {
+    json!({ "Motion": { "x": x, "y": y } })
+}
+
+pub fn button(button: u32, pressed: bool) -> Value {
+    json!({ "Button": { "button": button, "pressed": pressed } })
+}
+
+pub fn key(keycode: u16, pressed: bool) -> Value {
+    json!({ "Key": { "keycode": keycode, "pressed": pressed } })
+}
+
+pub fn axis(vertical: f64, horizontal: f64) -> Value {
+    json!({ "Axis": { "vertical": vertical, "horizontal": horizontal } })
+}
+
+pub fn text(text: &str, ctrl_shift_u: bool) -> Value {
+    let method = if ctrl_shift_u { "CtrlShiftU" } else { "Keymap" };
+    json!({ "Text": { "text": text, "unicode_input": method } })
+}
+
+/// Evdev button code for a Computer Use button name.
+pub fn button_code(name: Option<&str>) -> Result<u32> {
+    Ok(match name.map(str::to_ascii_lowercase).as_deref() {
+        None | Some("left") | Some("primary") => 0x110,
+        Some("right") | Some("secondary") => 0x111,
+        Some("middle") => 0x112,
+        Some("back") => 0x116,
+        Some("forward") => 0x115,
+        Some(other) => bail!("unsupported mouse button {other:?}"),
+    })
+}

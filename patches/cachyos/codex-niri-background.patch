+async fn run_chromium_unicode_hex_text(text: &str) -> std::result::Result<Vec<Output>, String> {
+    let mut outputs = Vec::new();
+    let mut ascii = String::new();
+    for character in text.chars() {
+        if character.is_ascii() {
+            ascii.push(character);
+            continue;
+        }
+        if !ascii.is_empty() {
+            outputs.push(run_ydotool_type_text(&ascii).await?);
+            ascii.clear();
+        }
+        let begin = key_sequence("Ctrl+Shift+U").expect("supported Unicode hex chord");
+        outputs.push(run_ydotool(&ydotool_key_args(begin, true)).await?);
+        sleep(Duration::from_millis(35)).await;
+        outputs.push(run_ydotool_type_text(&format!("{:x}", character as u32)).await?);
+        sleep(Duration::from_millis(35)).await;
+        let commit = key_sequence("Space").expect("supported Unicode hex commit key");
+        outputs.push(run_ydotool(&ydotool_key_args(commit, false)).await?);
+        sleep(Duration::from_millis(35)).await;
+    }
+    if !ascii.is_empty() {
+        outputs.push(run_ydotool_type_text(&ascii).await?);
+    }
+    Ok(outputs)
+}

+async fn run_wtype_text(text: &str) -> std::result::Result<Output, String> {
+    let executable = option_env!("COMPUTER_USE_WTYPE_EXECUTABLE").unwrap_or("wtype");
+    let mut command = TokioCommand::new(executable);
+    // niri drops the first event while attaching a fresh virtual keyboard.
+    // A modifier tap primes it without inserting text or touching the clipboard.
+    command.args(["-P", "Shift_L", "-p", "Shift_L", "-s", "50", "--", text]);
+    let output = crate::command_runner::output_with_timeout(
+        command,
+        "run wtype",
+        ydotool_type_timeout(text),
+    )
+    .await
+    .map_err(|error| format!("{error:#}"))?;
+    if output.status.success() {
+        Ok(output)
+    } else {
+        Err(format!(
+            "wtype failed: {}",
+            String::from_utf8_lossy(&output.stderr)
+        ))
+    }
+}
+
+fn chromium_browser_window(window: &WindowInfo) -> bool {
+    [window.app_id.as_deref(), window.wm_class.as_deref()]
+        .into_iter()
+        .flatten()
+        .any(|identity| {
+            matches!(
+                identity.to_ascii_lowercase().as_str(),
+                "microsoft-edge"
+                    | "microsoft-edge-stable"
+                    | "google-chrome"
+                    | "google-chrome-stable"
+                    | "chromium"
+                    | "chromium-browser"
+                    | "brave-browser"
+                    | "vivaldi-stable"
+            )
+        })
+}

+async fn hydrate_window_origins(windows: &mut [WindowInfo]) -> Result<()> {
+    let workspaces = niri_output_async(&["msg", "--json", "workspaces"])
+        .await
+        .context("failed to query Niri workspaces")?;
+    if !workspaces.status.success() {
+        bail!(
+            "niri workspaces query failed: {}",
+            command_failure_detail(&workspaces)
+        );
+    }
+    let workspaces: Vec<NiriWorkspace> =
+        serde_json::from_slice(&workspaces.stdout).context("failed to parse Niri workspaces")?;
+    let workspace_outputs = workspaces
+        .into_iter()
+        .filter_map(|workspace| {
+            let id = i32::try_from(workspace.id).ok()?;
+            Some((id, workspace.output?))
+        })
+        .collect::<HashMap<_, _>>();
+
+    let outputs = query_outputs().await?;
+    for window in windows {
+        let Some(workspace) = window.workspace else {
+            continue;
+        };
+        let Some(output_name) = workspace_outputs.get(&workspace) else {
+            continue;
+        };
+        let Some(output) = outputs.get(output_name) else {
+            continue;
+        };
+        let Some(logical) = output.logical.as_ref() else {
+            continue;
+        };
+        let Some(bounds) = window.bounds.as_mut() else {
+            continue;
+        };
+        if let (Some(x), Some(y)) = (bounds.x, bounds.y) {
+            bounds.x = x.checked_add(logical.x);
+            bounds.y = y.checked_add(logical.y);
+        }
+    }
+    Ok(())
+}

+fn interpolated_drag_points(start: (i32, i32), end: (i32, i32)) -> Vec<(i32, i32)> {
+    let dx = i64::from(end.0) - i64::from(start.0);
+    let dy = i64::from(end.1) - i64::from(start.1);
+    let distance = dx.abs().max(dy.abs());
+    let steps = ((distance + 31) / 32).clamp(2, 32);
+    (1..=steps)
+        .map(|step| {
+            (
+                (i64::from(start.0) + dx * step / steps) as i32,
+                (i64::from(start.1) + dy * step / steps) as i32,
+            )
+        })
+        .collect()
+}

+            );
+        }
+        Ok((
+            origin_x
+                .checked_add(x)
+                .ok_or_else(|| "Relative drag x coordinate overflowed.".to_string())?,
+            origin_y
+                .checked_add(y)
+                .ok_or_else(|| "Relative drag y coordinate overflowed.".to_string())?,
+        ))
+    };
+    (params.start_x, params.start_y) = translate(params.start_x, params.start_y)?;
+    (params.end_x, params.end_y) = translate(params.end_x, params.end_y)?;
+    Ok(())
